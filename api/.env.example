# Database Connection (TiDB Cloud)
# Use full connection string with SSL (recommended)
DATABASE_URL=mysql://username:password@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/world?ssl={"rejectUnauthorized":true}

# OR use individual environment variables (optional fallback)
# DB_HOST=gateway01.ap-northeast-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=root
# DB_PASSWORD=your_tidb_password_here
# DB_NAME=world

# Clerk Authentication
CLERK_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_public_key_here
