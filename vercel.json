{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "./publish.sh",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health.js"
    },
    {
      "source": "/api/users/sync",
      "destination": "/api/users/sync.js"
    },
    {
      "source": "/api/worlds",
      "destination": "/api/worlds/index.js"
    },
    {
      "source": "/api/worlds/:id",
      "destination": "/api/worlds/[id].js"
    },
    {
      "source": "/api/worlds/:id/builds",
      "destination": "/api/worlds/[id]/builds.js"
    },
    {
      "source": "/api/worlds/:id/builds/:buildId/restore",
      "destination": "/api/worlds/[id]/builds/[buildId]/restore.js"
    },
    {
      "source": "/api/preferences",
      "destination": "/api/preferences.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' blob: data: https: http: ws: wss:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    }
  ]
}
